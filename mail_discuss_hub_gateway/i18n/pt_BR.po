#. module: mail_discuss_hub_gateway
#: model:ir.model.fields,field_description:mail_discuss_hub_gateway.field_mail_gateway__outgoing_signature
#: model:ir.model.fields,field_description:mail_discuss_hub_gateway.field_discuss_hub_inbox__outgoing_signature
msgid "Outgoing signature"
msgstr "Assinatura de saida"

#. module: mail_discuss_hub_gateway
#: model:ir.model.fields,help:mail_discuss_hub_gateway.field_mail_gateway__outgoing_signature
#: model:ir.model.fields,help:mail_discuss_hub_gateway.field_discuss_hub_inbox__outgoing_signature
msgid ""
"When enabled, Odoo prepends the message author name to outbound text "
"messages (e.g. '*Mitchel Admin:* Hello'). Useful when multiple internal "
"users share the same gateway."
msgstr ""
"Quando ativado, o Odoo adiciona o nome do autor no inicio das mensagens de "
"texto de saida (ex.: '*Mitchel Admin:* Ola'). Util quando varios usuarios "
"internos compartilham o mesmo gateway."

#. module: mail_discuss_hub_gateway
#: model:ir.model.fields,field_description:mail_discuss_hub_gateway.field_mail_gateway__reopen_archived_conversations
#: model:ir.model.fields,field_description:mail_discuss_hub_gateway.field_discuss_hub_inbox__reopen_archived_conversations
msgid "Reopen archived conversations"
msgstr "Reabrir conversas arquivadas"

#. module: mail_discuss_hub_gateway
#: model:ir.model.fields,help:mail_discuss_hub_gateway.field_mail_gateway__reopen_archived_conversations
#: model:ir.model.fields,help:mail_discuss_hub_gateway.field_discuss_hub_inbox__reopen_archived_conversations
msgid ""
"When enabled, any inbound or outbound gateway message will reopen archived "
"conversations instead of creating a new one."
msgstr ""
"Quando ativado, qualquer mensagem recebida ou enviada pelo gateway reabrira "
"conversas arquivadas em vez de criar uma nova."

#. module: mail_discuss_hub_gateway
#: model:ir.model.fields,field_description:mail_discuss_hub_gateway.field_mail_gateway__outgoing_signature_format
#: model:ir.model.fields,field_description:mail_discuss_hub_gateway.field_discuss_hub_inbox__outgoing_signature_format
msgid "Signature format"
msgstr "Formato da assinatura"

#. module: mail_discuss_hub_gateway
#: model:ir.model.fields,help:mail_discuss_hub_gateway.field_mail_gateway__outgoing_signature_format
#: model:ir.model.fields,help:mail_discuss_hub_gateway.field_discuss_hub_inbox__outgoing_signature_format
msgid ""
"Format used when 'Outgoing signature' is enabled. Supports: {author}. Tip: "
"you can use \\n for a new line. Example: '*{author}:*\\n'."
msgstr ""
"Formato usado quando 'Assinatura de saida' estiver ativada. Suporta: "
"{author}. Dica: voce pode usar \\n para nova linha. Exemplo: "
"'*{author}:*\\n'."
