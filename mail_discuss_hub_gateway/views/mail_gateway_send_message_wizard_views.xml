<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_gateway_send_message_wizard_view_form" model="ir.ui.view">
        <field name="name">mail.gateway.send.message.wizard.form</field>
        <field name="model">mail.gateway.send.message.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Message">
                <group>
                    <field name="gateway_id" readonly="1"/>
                    <field name="partner_id"/>
                    <field name="to" placeholder="+5511999999999"/>
                </group>
                <group>
                    <field
                        name="body"
                        widget="text"
                        placeholder="Type your message..."
                        nolabel="1"
                        colspan="2"
                    />
                    <field name="attachment_ids" widget="many2many_binary"/>
                </group>
                <footer>
                    <button
                        name="action_send"
                        type="object"
                        string="Send"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

