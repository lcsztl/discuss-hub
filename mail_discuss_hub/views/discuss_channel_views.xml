<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="mail_discuss_hub_discuss_channel_view_form" model="ir.ui.view">
        <field name="name">discuss.channel.form.discuss.hub.messages</field>
        <field name="model">discuss.channel</field>
        <field name="inherit_id" ref="mail.discuss_channel_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@class='o_label_nowrap']/field[@name='description']" position="after">
                <field
                    name="discuss_hub_tag_ids"
                    widget="many2many_tags"
                    readonly="not is_editable"
                />
            </xpath>
            <xpath expr="//page[@name='privacy']//field[@name='group_public_id']" position="attributes">
                <attribute name="invisible">channel_type != 'channel' or parent_channel_id</attribute>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Mensagens" name="messages">
                    <field name="message_ids"
                           mode="list"
                           context="{'default_model': 'discuss.channel', 'default_res_id': id}"
                           domain="[('model', '=', 'discuss.channel'), ('res_id', '=', id)]">
                        <list create="false" delete="false">
                            <field name="date"/>
                            <field name="subject"/>
                            <field name="author_id"/>
                            <field name="message_type"/>
                            <field name="subtype_id"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
