<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="mail_discuss_hub_channel_kanban_view" model="ir.ui.view">
            <field name="name">discuss.channel.kanban.discuss.hub</field>
            <field name="model">discuss.channel</field>
            <field name="arch" type="xml">
                <kanban class="o_discuss_hub_kanban" default_group_by="discuss_hub_stage_id">
                    <field name="name"/>
                    <field name="channel_type"/>
                    <field name="active"/>
                    <field name="last_interest_dt"/>
                    <field name="discuss_team_id"/>
                    <field name="discuss_hub_stage_id"/>
                    <field name="discuss_hub_tag_ids"/>

                    <templates>
                        <t t-name="kanban-box">
                            <div class="o_kanban_record">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                        <div class="text-muted small" t-if="record.discuss_team_id.raw_value">
                                            <span>
                                                <field name="discuss_team_id"/>
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-2">
                                    <field name="discuss_hub_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                </div>

                                <div class="mt-2 text-muted small" t-if="record.last_interest_dt.raw_value">
                                    <span>Ultima atividade:</span>
                                    <span class="ms-1">
                                        <field name="last_interest_dt" widget="datetime"/>
                                    </span>
                                </div>

                                <div class="mt-2 d-flex gap-2">
                                    <a type="object" name="action_open_discuss" class="btn btn-link btn-sm p-0">
                                        Abrir chat
                                    </a>
                                    <a type="edit" class="btn btn-link btn-sm p-0">
                                        Editar
                                    </a>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="mail_discuss_hub_channel_search_view" model="ir.ui.view">
            <field name="name">discuss.channel.search.discuss.hub.kanban</field>
            <field name="model">discuss.channel</field>
            <field name="arch" type="xml">
                <search string="Conversas">
                    <field name="name" string="Conversa"/>
                    <field name="discuss_team_id"/>
                    <field name="discuss_hub_stage_id"/>
                    <field name="discuss_hub_tag_ids"/>

                    <filter string="Ativas" name="active" domain="[('active','=',True)]"/>
                    <filter string="Arquivadas" name="archived" domain="[('active','=',False)]"/>
                    <separator/>
                    <filter string="Minhas" name="mine" domain="[('is_member','=',True)]"/>
                    <filter
                        string="Nao atribuidas"
                        name="unassigned"
                        domain="[('channel_member_ids', 'not any', [('partner_id.user_ids.share', '=', False)])]"
                    />

                    <group expand="0" string="Agrupar por">
                        <filter string="Stage" name="group_stage" context="{'group_by': 'discuss_hub_stage_id'}"/>
                        <filter string="Team" name="group_team" context="{'group_by': 'discuss_team_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="mail_discuss_hub_channel_kanban_action" model="ir.actions.act_window">
            <field name="name">Kanban de Conversas</field>
            <field name="res_model">discuss.channel</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="view_id" ref="mail_discuss_hub_channel_kanban_view"/>
            <field name="search_view_id" ref="mail_discuss_hub_channel_search_view"/>
            <field name="domain">[("channel_type", "=", "gateway")]</field>
            <field name="context">{"group_by": "discuss_hub_stage_id"}</field>
        </record>

        <menuitem
            id="mail_discuss_hub_channel_kanban_menu"
            name="Kanban"
            parent="mail.menu_root_discuss"
            action="mail_discuss_hub_channel_kanban_action"
            sequence="2"
            groups="base.group_user"
        />
    </data>
</odoo>
