<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_devtools_llm" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.devtools.llm</field>
        <field name="model">res.config.settings</field>
        <field name="priority">96</field>
        <field name="inherit_id" ref="mail_discuss_hub_gateway_devtools.res_config_settings_view_form_inherit_devtools" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='devtools_webhooks']/setting[@id='devtools_gap_checklist_enabled']" position="after">
                <setting
                    id="devtools_llm_trace_enabled"
                    string="LLM trace"
                    help="Persist rendered prompt, context and request/response snapshots for Gateway AI runs."
                >
                    <field name="llm_trace_enabled"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
