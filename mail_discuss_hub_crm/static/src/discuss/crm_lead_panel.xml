<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mail_discuss_hub_crm.CrmLeadPanel">
        <ActionPanel title.translate="Lead" minWidth="260" initialWidth="380" icon="'fa fa-briefcase'">
            <div class="d-flex flex-column gap-3 px-2">
                <t t-if="state.loading">
                    <div class="text-muted">Carregando...</div>
                </t>
                <t t-else="">
                    <t t-if="hasLeads">
                        <div>
                            <div class="fw-semibold mb-1">Leads vinculados</div>
                            <ul class="list-unstyled mb-0">
                                <li t-foreach="state.leads" t-as="lead" t-key="lead.id">
                                    <button class="btn btn-link p-0 text-start"
                                            t-on-click="() => this.openLead(lead.id)">
                                        <t t-esc="lead.name"/>
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </t>
                    <div class="border-top pt-2">
                        <div class="fw-semibold mb-2">Criar lead</div>
                        <div class="d-flex flex-column gap-2">
                            <div>
                                <label class="form-label mb-1">Titulo</label>
                                <input class="form-control"
                                       type="text"
                                       t-model="state.name"
                                       placeholder="Ex.: Novo cliente interessado"/>
                            </div>
                            <div>
                                <label class="form-label mb-1">Equipe</label>
                                <select class="form-select" t-model.number="state.teamId">
                                    <option t-att-value="null">Sem equipe</option>
                                    <option t-foreach="state.teams" t-as="team" t-key="team.id"
                                            t-att-value="team.id">
                                        <t t-esc="team.name"/>
                                    </option>
                                </select>
                            </div>
                            <button class="btn btn-primary"
                                    t-on-click="createLead"
                                    t-att-disabled="state.creating or !state.canCreate">
                                <t t-if="state.creating">Criando...</t>
                                <t t-else="">Criar lead</t>
                            </button>
                            <t t-if="!state.canCreate">
                                <div class="text-muted small">
                                    Sem permissao para criar leads.
                                </div>
                            </t>
                        </div>
                    </div>
                </t>
            </div>
        </ActionPanel>
    </t>
</templates>
