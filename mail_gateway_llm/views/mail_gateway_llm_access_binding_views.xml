<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="mail_gateway_llm_access_binding_view_tree" model="ir.ui.view">
        <field name="name">mail.gateway.llm.access.binding.tree</field>
        <field name="model">mail.gateway.llm.access.binding</field>
        <field name="arch" type="xml">
            <list>
                <field name="active"/>
                <field name="name"/>
                <field name="principal_partner_id"/>
                <field name="gateway_id"/>
                <field name="company_id"/>
                <field name="verification_mode"/>
                <field name="allow_sensitive_data"/>
            </list>
        </field>
    </record>

    <record id="mail_gateway_llm_access_binding_view_form" model="ir.ui.view">
        <field name="name">mail.gateway.llm.access.binding.form</field>
        <field name="model">mail.gateway.llm.access.binding</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="active"/>
                            <field name="name"/>
                            <field name="principal_partner_id"/>
                            <field name="gateway_id"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="verification_mode"/>
                            <field name="allow_sensitive_data"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mail_gateway_llm_access_binding_view_search" model="ir.ui.view">
        <field name="name">mail.gateway.llm.access.binding.search</field>
        <field name="model">mail.gateway.llm.access.binding</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="principal_partner_id"/>
                <field name="gateway_id"/>
                <field name="company_id"/>
                <filter
                    name="allow_sensitive_data"
                    string="Sensitive Data Allowed"
                    domain="[('allow_sensitive_data', '=', True)]"
                />
            </search>
        </field>
    </record>

    <record id="mail_gateway_llm_access_binding_action" model="ir.actions.act_window">
        <field name="name">Gateway AI Access Bindings</field>
        <field name="res_model">mail.gateway.llm.access.binding</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="mail_gateway_llm_access_binding_view_search"/>
    </record>

    <menuitem
        id="mail_gateway_llm_access_binding_menu"
        name="Gateway AI Access Bindings"
        parent="mail_gateway.mail_gateway_menu"
        action="mail_gateway_llm_access_binding_action"
        sequence="18"
        groups="base.group_system"
    />
</odoo>
