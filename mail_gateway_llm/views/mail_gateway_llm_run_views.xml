<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="mail_gateway_llm_run_view_tree" model="ir.ui.view">
        <field name="name">mail.gateway.llm.run.tree</field>
        <field name="model">mail.gateway.llm.run</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="state"/>
                <field name="run_type"/>
                <field name="mode"/>
                <field name="gateway_id"/>
                <field name="channel_id"/>
                <field name="source_message_id"/>
                <field name="assistant_id"/>
                <field name="attempt_count"/>
                <field name="next_attempt_at"/>
                <field name="processed_at"/>
            </list>
        </field>
    </record>

    <record id="mail_gateway_llm_run_view_form" model="ir.ui.view">
        <field name="name">mail.gateway.llm.run.form</field>
        <field name="model">mail.gateway.llm.run</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="state" readonly="1"/>
                            <field name="run_type" readonly="1"/>
                            <field name="mode" readonly="1"/>
                            <field name="gateway_id" readonly="1"/>
                            <field name="channel_id" readonly="1"/>
                            <field name="thread_id" readonly="1"/>
                            <field name="assistant_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="source_message_id" readonly="1"/>
                            <field name="notification_id" readonly="1"/>
                            <field name="thread_message_id" readonly="1"/>
                            <field name="assistant_message_id" readonly="1"/>
                            <field name="published_message_id" readonly="1"/>
                            <field name="attempt_count" readonly="1"/>
                            <field name="next_attempt_at" readonly="1"/>
                            <field name="processed_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Suggestion">
                            <field name="assistant_body" readonly="1" widget="html"/>
                        </page>
                        <page string="Payload">
                            <field name="payload_json" readonly="1"/>
                        </page>
                        <page string="Error">
                            <field name="error_text" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mail_gateway_llm_run_view_search" model="ir.ui.view">
        <field name="name">mail.gateway.llm.run.search</field>
        <field name="model">mail.gateway.llm.run</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="gateway_id"/>
                <field name="channel_id"/>
                <field name="assistant_id"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="errors" string="Errors" domain="[('state', '=', 'error')]"/>
                <filter name="inbound" string="Inbound" domain="[('run_type', '=', 'inbound')]"/>
                <filter name="outbound" string="Outbound" domain="[('run_type', '=', 'outbound')]"/>
            </search>
        </field>
    </record>

    <record id="mail_gateway_llm_run_action" model="ir.actions.act_window">
        <field name="name">Gateway AI Runs</field>
        <field name="res_model">mail.gateway.llm.run</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="mail_gateway_llm_run_view_search"/>
    </record>

    <menuitem
        id="mail_gateway_llm_run_menu"
        name="Gateway AI Runs"
        parent="mail_gateway.mail_gateway_menu"
        action="mail_gateway_llm_run_action"
        sequence="17"
    />
</odoo>
