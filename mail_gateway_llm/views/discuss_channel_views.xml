<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="discuss_channel_view_form_gateway_llm" model="ir.ui.view">
        <field name="name">discuss.channel.form.gateway.llm</field>
        <field name="model">discuss.channel</field>
        <field name="inherit_id" ref="mail.discuss_channel_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    type="object"
                    name="action_open_llm_thread"
                    class="oe_stat_button"
                    string="AI Thread"
                    icon="fa-comments-o"
                    invisible="channel_type != 'gateway' or not gateway_id or not llm_assistant_id"
                />
                <button
                    type="object"
                    name="action_view_llm_runs"
                    class="oe_stat_button"
                    icon="fa-list"
                    invisible="channel_type != 'gateway' or llm_run_count == 0"
                >
                    <field name="llm_run_count" widget="statinfo" string="AI Runs"/>
                </button>
            </xpath>
            <xpath expr="//group[hasclass('o_label_nowrap')]/field[@name='description']" position="after">
                <field name="llm_assistant_id" invisible="channel_type != 'gateway'" readonly="1"/>
                <field name="llm_state" invisible="channel_type != 'gateway'"/>
                <field name="llm_thread_id" invisible="channel_type != 'gateway'" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
